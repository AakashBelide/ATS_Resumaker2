# Minimal sandbox base — the disposable box the onboarding agent runs inside.
# Deliberately tiny: python + curl + httpx. NO secrets, NO app source, NO node/claude here
# (the agent image, Dockerfile.agent, adds those on top for Phase B). Used as-is for the
# Phase-A containment tests, which need only a shell + curl on the isolated network.
FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir httpx
# Unprivileged, no home write needs; /work is a tmpfs mounted at runtime.
RUN useradd -u 10001 -m agent
USER 10001
WORKDIR /work
