# Copy to .env and fill in. .env is gitignored (never commit real keys).

# ------------------------------------------------------------------ core config
# Environment tag: local | vm | ci (informational; drives a couple of defaults).
RESUMAKER_ENVIRONMENT=local

# LLM engine for cognitive stages: claude | anthropic | gemini.
#  - claude   = Claude CLI (subscription, $0 tokens). Great locally; NOT on a headless VM.
#  - anthropic= Anthropic API (credits). The recommended engine for a deployed VM.
RESUMAKER_DEFAULT_PROVIDER=claude

# API auth: when set, every /v1 request must present this token
# (Authorization: Bearer <token> or X-API-Key). REQUIRED on any exposed VM.
RESUMAKER_API_TOKEN=

# ------------------------------------------------------------------ LLM secrets
# Needed when DEFAULT_PROVIDER=anthropic (or for parity tests). Conventional name.
ANTHROPIC_API_KEY=

# Gemini API (hard-capped at $5 by the cost guard). Only for `--semantic gemini`,
# embeddings, and Gemini fallback; the default pipeline does not need it.
GEMINI_API_KEY=

# ------------------------------------------------------------------ watchlist scheduler
# When true, the API polls the watchlist every N minutes, dedupes, and notifies on new
# preference-matching postings (never runs the pipeline or applies).
RESUMAKER_SCHEDULER_ENABLED=false
# Clean public boards (Greenhouse/Lever/Ashby) poll often; Workday (Akamai, throttles) daily.
RESUMAKER_SCHEDULER_INTERVAL_MINUTES=60
RESUMAKER_SCHEDULER_WORKDAY_INTERVAL_MINUTES=1440
# Optional: POST a JSON digest of new postings to this webhook (Slack/Discord/etc.).
RESUMAKER_NOTIFY_WEBHOOK=

# Optional: email digest of new on-target postings via SMTP. Recommended = a Gmail
# App Password (Google account -> Security -> 2-Step Verification -> App passwords; NOT your
# real password). All values live ONLY here in .env (gitignored) - never committed. Leave
# SMTP_HOST blank to disable email. FROM defaults to USER if omitted.
RESUMAKER_SMTP_HOST=
RESUMAKER_SMTP_PORT=587
RESUMAKER_SMTP_USER=
RESUMAKER_SMTP_PASS=
RESUMAKER_NOTIFY_TO=
RESUMAKER_NOTIFY_FROM=

# ------------------------------------------------------------------ deploy (Caddy)
# Set to your hostname for automatic HTTPS (e.g. resumaker.example.com); leave blank
# for plain HTTP on :80 (local/VM testing).
DOMAIN=

# ------------------------------------------------------------------ Affinda (OPTIONAL)
# Independent industry parse oracle (validation only, not in the pipeline).
# Free tier: https://app.affinda.com  (region-scoped - set BASE_URL to your account's region).
AFFINDA_API_KEY=
AFFINDA_WORKSPACE=
AFFINDA_DOCUMENT_TYPE=
#   https://api.affinda.com (APAC) | https://api.us1.affinda.com (US) | https://api.eu1.affinda.com (EU)
AFFINDA_BASE_URL=
AFFINDA_COLLECTION=
