# Copy to .env and fill in. .env is gitignored (never commit real keys).

# Gemini API (hard-capped at $5 by core/cost_guard). Only needed for the optional
# `--semantic gemini` mode and any Gemini fallback; the pipeline runs on the Claude
# CLI subscription by default, so this can stay unset for most use.
GEMINI_API_KEY=

# Affinda resume parser (Phase 3.4, OPTIONAL) - independent industry parse oracle.
# Free tier: sign up at https://app.affinda.com, create an API key, and create a
# Collection using the "Resume Parser" extractor; put its id in AFFINDA_COLLECTION.
AFFINDA_API_KEY=
AFFINDA_COLLECTION=
