# Copy to .env and fill in. .env is gitignored (never commit real keys).

# Gemini API (hard-capped at $5 by core/cost_guard). Only needed for the optional
# `--semantic gemini` mode and any Gemini fallback; the pipeline runs on the Claude
# CLI subscription by default, so this can stay unset for most use.
GEMINI_API_KEY=

# Affinda resume parser (Phase 3.4, OPTIONAL) - independent industry parse oracle.
# Free tier: sign up at https://app.affinda.com, create an API key, and use your
# WORKSPACE identifier (Affinda organizes uploads by workspace + document type).
AFFINDA_API_KEY=
AFFINDA_WORKSPACE=
# Resume Parser document-type id (find via GET /v3/document_types?workspace=<id>).
AFFINDA_DOCUMENT_TYPE=
# Affinda is region-scoped; a token only works against its account's region:
#   https://api.affinda.com (APAC, default) | https://api.us1.affinda.com (US)
#   | https://api.eu1.affinda.com (EU). Leave blank for APAC.
AFFINDA_BASE_URL=
AFFINDA_COLLECTION=
